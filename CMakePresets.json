{
    "version": 6,
    "configurePresets": [
        {
            "name": "reldebinfo",
            "binaryDir": "${sourceDir}/build/reldebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "release",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "bench",
            "binaryDir": "${sourceDir}/build/bench",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "tests",
            "binaryDir": "${sourceDir}/build/tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "reldebinfo",
            "configurePreset": "reldebinfo"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "bench",
            "configurePreset": "bench",
            "targets": [
                "pixeldither_bench"
            ]
        },
        {
            "name": "tests",
            "configurePreset": "tests",
            "targets": [
                "pixeldither_tests"
            ]
        }
    ]
}